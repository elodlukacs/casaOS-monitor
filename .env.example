# Copy to .env (same folder as docker-compose.yml) and fill in what you use.
# .env is gitignored, so tokens stay out of git. Apply with:
#   docker compose up -d

# ---- access (see README) ----
# Extra browser origins, comma separated, e.g. https://monitor.example.com
ALLOWED_ORIGINS=
# Shared secret; open the page once as http://<nas>:3030/?token=<value>.
# The Android app cannot send it and stops connecting while this is set.
MONITOR_TOKEN=

# ---- phone alerts: set one or more ----
# ntfy: install the ntfy app, subscribe to a long random topic name.
NTFY_URL=
# only for a protected (self-hosted or reserved) topic
NTFY_TOKEN=
# Discord: channel settings -> Integrations -> Webhooks -> Copy URL
DISCORD_WEBHOOK_URL=
# Telegram: bot token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# crit (default) or warn
ALERT_LEVEL=crit
ALERT_AFTER_SECONDS=60
ALERT_REPEAT_HOURS=6

# ---- Plex now-playing panel ----
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
