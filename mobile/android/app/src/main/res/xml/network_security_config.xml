<?xml version="1.0" encoding="utf-8"?>
<!-- The backend speaks plain ws:// on the LAN, so allow cleartext everywhere.
     (domain-config entries only match hostnames, not IP ranges, so listing
     subnets there does nothing; base-config is what actually applies.) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
